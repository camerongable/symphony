#!/bin/zsh
set -euo pipefail

script_dir="${0:A:h}"
elixir_dir="${script_dir:h}"
workflow_path="${1:-${elixir_dir}/WORKFLOW.local.md}"
logs_root="${SYMPHONY_FACTORY_LOGS_ROOT:-${HOME}/Library/Logs/ai-factory}"

codex_resources="/Applications/ChatGPT.localized/ChatGPT.app/Contents/Resources"
export PATH="${codex_resources}/codex-cli/CodexCLI.app/Contents/MacOS:${codex_resources}:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"

if ! command -v codex >/dev/null 2>&1; then
  print -u2 "Factory startup requires the Codex CLI in the app bundle or PATH"
  exit 127
fi

cd "${elixir_dir}"

mix_prebuilt_args=()
if [[ -n "${MIX_BUILD_PATH:-}" ]]; then
  if [[ ! -f "${MIX_BUILD_PATH}/lib/symphony_elixir/ebin/symphony_elixir.app" || ! -f "${MIX_BUILD_PATH}/lib/symphony_elixir/ebin/Elixir.SymphonyElixir.Factory.Controller.beam" ]]; then
    print -u2 "Explicit MIX_BUILD_PATH requires a compiled factory application"
    exit 78
  fi
  mix_prebuilt_args=(--no-compile --no-deps-check)
fi

exec /opt/homebrew/bin/mise exec -- \
  mix run "${mix_prebuilt_args[@]}" --no-start -e 'SymphonyElixir.CLI.main(System.argv())' -- \
  --i-understand-that-this-will-be-running-without-the-usual-guardrails \
  --logs-root "${logs_root}" \
  "${workflow_path}"
