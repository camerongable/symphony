+defmodule SymphonyElixir.Factory.CiPolicy do
+  @moduledoc "Repository-bound ordinary merge-request CI requirements."
+
+  @projects %{
+    "grail" => "grailbio/grail",
+    "polaris" => "grailbio/teams/polaris/polaris",
+    "augusta" => "grailbio/teams/cat/augusta",
+    "blackburn" => "grailbio/teams/cat/blackburn",
+    "prepost" => "grailbio/teams/prepost/prepost"
+  }
+  @client ~w(build_client_feature lint_client format_client unit_tests_client build_server lint_server format_server unit_tests_server_feature docker_test)
+  @project_ids %{"grail" => 33_747_681, "polaris" => 80_500_661, "augusta" => 47_773_868, "blackburn" => 47_773_823}
+  @anchors %{
+    "grail" => ["bazel"],
+    "polaris" => ["verify_pipeline"],
+    "augusta" => @client ++ ["typecheck_server"],
+    "blackburn" => @client ++ ~w(integration_tests_client build_verify_client lint_verify_client unit_tests_verify_client),
+    "prepost" =>
+      ~w(client-build client-lint client-codegen client-type-check client-unit-test-aggregator interaction-tests server-build server-lint server-type-check server-unit-tests container-build) ++
+        Enum.map(1..4, &"client-unit-tests #{&1}/4")
+  }
+
+  @spec known_route?(String.t(), String.t()) :: boolean()
+  def known_route?(key, project), do: Map.get(@projects, key) == project and Map.has_key?(@projects, key)
+
+  @spec admission(map(), String.t()) :: :ok | {:error, atom()}
+  def admission(route, key) do
+    case Map.get(route, "ci_preflight", "draft_mr") do
+      "verification_first" ->
+        :ok
+
+      "draft_mr" ->
+        cond do
+          not known_route?(key, route["gitlab_project"]) -> {:error, :ci_repository_policy_unknown}
+          key == "prepost" -> {:error, :ci_selectors_unobservable_requires_verification_first}
+          true -> :ok
+        end
+
+      _ ->
+        {:error, :invalid_ci_preflight_route}
+    end
+  end
+
+  @spec anchors(String.t()) :: {:ok, [String.t()]} | {:error, atom()}
+  def anchors(key) do
+    case Map.fetch(@anchors, key) do
+      {:ok, names} -> {:ok, names}
+      :error -> {:error, :ci_repository_policy_unknown}
+    end
+  end
+
+  @spec bind(map(), map()) :: {:ok, [String.t()]} | {:error, atom()}
+  def bind(run, mr) do
+    key = run["repo_key"]
+
+    with {:ok, names} <- anchors(key),
+         true <- key == "prepost" or mr["project_id"] == @project_ids[key] or {:error, :ci_repository_policy_mismatch},
+         true <- mr["web_url"] == "https://gitlab.com/#{@projects[key]}/-/merge_requests/#{mr["iid"]}" or {:error, :ci_repository_policy_mismatch} do
+      {:ok, names}
+    end
+  end
+
+  @spec passed?(map(), String.t()) :: boolean()
+  def passed?(evidence, key) do
+    with {:ok, names} <- anchors(key),
+         true <- evidence["ci_policy"] == key,
+         jobs when is_list(jobs) <- evidence["required_jobs"],
+         true <- Enum.all?(jobs, &is_map/1),
+         %{} = proof <- evidence["jobs_collection"] do
+      key != "prepost" and Enum.all?(names, fn name -> Enum.count(jobs, &(&1["name"] == name and &1["status"] == "success")) == 1 end) and
+        Enum.all?(
+          jobs,
+          &(&1["status"] == "success" and &1["allow_failure"] == false and get_in(&1, ["pipeline", "id"]) == evidence["pipeline_id"] and get_in(&1, ["pipeline", "sha"]) == evidence["pipeline_sha"])
+        ) and
+        proof["pipeline_id"] == evidence["pipeline_id"] and proof["pipeline_sha"] == evidence["pipeline_sha"] and
+        proof["pages"] == [1, 2] and proof["per_page"] == 100 and proof["include_retried"] == false and
+        proof["terminal_page_empty"] == true and is_integer(proof["observed_count"]) and
+        proof["observed_count"] >= length(jobs) and proof["observed_count"] <= 100
+    else
+      _ -> false
+    end
+  end
+end
