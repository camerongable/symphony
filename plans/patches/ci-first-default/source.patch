+defmodule SymphonyElixir.FactoryCiPolicyTest do
+  use ExUnit.Case, async: true
+  alias SymphonyElixir.Config.Schema
+  alias SymphonyElixir.Factory.CiPolicy
+
+  test "factory default is inherited and explicit verification-first is preserved" do
+    assert {:ok, settings} = Schema.parse(%{"factory" => %{"repositories" => %{"a" => %{}, "b" => %{"ci_preflight" => "verification_first"}}}})
+    assert settings.factory.ci_preflight == "draft_mr"
+    assert settings.factory.repositories["a"]["ci_preflight"] == "draft_mr"
+    assert settings.factory.repositories["b"]["ci_preflight"] == "verification_first"
+    assert {:error, _} = Schema.parse(%{"factory" => %{"ci_preflight" => "guess"}})
+  end
+
+  test "all configured repositories have distinct real MR anchors and structural shards" do
+    for {key, count} <- [{"grail", 1}, {"polaris", 1}, {"augusta", 10}, {"blackburn", 13}, {"prepost", 15}] do
+      assert {:ok, names} = CiPolicy.anchors(key)
+      assert length(names) == count
+      refute Enum.any?(names, &String.ends_with?(&1, "_main"))
+    end
+
+    assert {:ok, names} = CiPolicy.anchors("prepost")
+    refute "client-unit-tests" in names
+    assert "client-unit-tests 4/4" in names
+    assert {:error, :ci_repository_policy_unknown} = CiPolicy.anchors("unknown")
+    refute CiPolicy.known_route?("grail", "other/grail")
+  end
+
+  test "unsupported selectors and unknown policies deny before mutation unless explicitly opted out" do
+    assert {:error, :ci_selectors_unobservable_requires_verification_first} = CiPolicy.admission(%{"gitlab_project" => "grailbio/teams/prepost/prepost"}, "prepost")
+    assert {:error, :ci_repository_policy_unknown} = CiPolicy.admission(%{"gitlab_project" => "example/repo"}, "unknown")
+    assert :ok = CiPolicy.admission(%{"ci_preflight" => "verification_first"}, "unknown")
+    assert {:error, :invalid_ci_preflight_route} = CiPolicy.admission(%{"ci_preflight" => "guess"}, "grail")
+  end
+end
